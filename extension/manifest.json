{
  "manifest_version": 3,
  "name": "Mindset Machine — Focus Stream & Quick Capture",
  "version": "1.0.0",
  "description": "Monk-mode task manager, micro-steps checklist, and quick web capture companion for Mindset Machine.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "action": {
    "default_title": "Mindset Machine",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
